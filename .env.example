# Transaction Shield — Environment Variables Template
# Copy to .env and fill in production values. Never commit .env to git.
#
# Usage:
#   cp .env.example .env
#   docker compose --env-file .env up -d
#
# Services read these at startup via ${VAR_NAME:default} in application.yml.

# ── Database ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transactionshield
DB_USERNAME=tsuser
DB_PASSWORD=tspassword

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka / Schema Registry ───────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# ── Security ──────────────────────────────────────────────────────────
# transaction-producer: HS256 JWT secret — must be >= 32 bytes (256 bits)
# Generate: openssl rand -base64 32
JWT_SECRET_KEY=dev-jwt-secret-changeme-minimum-32-bytes!!

# fraud-engine + alert-service: internal service-to-service API key
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=internal-dev-key-change-in-production

# ── AWS Secrets Manager (ECS / production) ────────────────────────────
# Uncomment to pull the above vars from AWS instead of a .env file:
#   spring.config.import=aws-secretsmanager:/transaction-shield/production
#
# The secret must be a JSON map with keys matching the variable names above.
# Add spring-cloud-aws-starter-secrets-manager to the relevant pom.xml and
# set: AWS_REGION=eu-west-1 (or configure region via Spring Cloud AWS)

# ── HashiCorp Vault (optional alternative) ───────────────────────────
# spring.config.import=vault://transaction-shield/
# SPRING_CLOUD_VAULT_HOST=vault.internal
# SPRING_CLOUD_VAULT_PORT=8200
# VAULT_TOKEN=<token>
