<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        OWASP Dependency-Check False Positive Suppressions
        =====================================================
        Add entries here for known false positives that block the build.
        Each entry must include a <notes> element explaining WHY it is suppressed
        and an expiry date so stale suppressions are caught.

        Format:
            <suppress until="YYYY-MM-DD">
                <notes>CVE-XXXX-XXXXX: reason — reviewed YYYY-MM-DD</notes>
                <cve>CVE-XXXX-XXXXX</cve>
            </suppress>

        Example (placeholder — add real suppressions as needed):

        <suppress until="2027-01-01">
            <notes>CVE-2023-XXXXX: affects feature X which we do not use — reviewed 2026-05-30</notes>
            <packageUrl regex="true">^pkg:maven/com\.example/library@.*$</packageUrl>
            <cve>CVE-2023-XXXXX</cve>
        </suppress>
    -->
</suppressions>
